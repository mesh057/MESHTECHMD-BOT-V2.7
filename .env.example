# Secrets belong in the deployment provider's secret manager or a local untracked .env.
# Never commit a real token, recovery ID, or admin token.
SESSION_ID=
GITHUB_TOKEN=
GITHUB_USERNAME=mesh057
GITHUB_REPO_NAME=MESHTECHMD-BOT-V2.7-SESSIONS
GITHUB_BRANCH=main

# Set to a long random secret to enable destructive web actions (force pairing/disconnect).
# Leave empty to keep those actions disabled.
PAIRING_ADMIN_TOKEN=

# Optional panel pairing mode; package scripts/panel-startup.sh set this automatically.
MESH_PAIRING_MODE=web
MESH_PAIRING_PHONE_NUMBER=

# Optional public https URL used for clickable pairing links sent by .pair.
PAIRING_BASE_URL=
